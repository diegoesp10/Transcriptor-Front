{
  "name": "murmur-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.production server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:check": "node scripts/check-contract.mjs",
    "mock": "node scripts/mock-backend.mjs",
    "docker:build": "docker build -t murmur .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env.production murmur"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
