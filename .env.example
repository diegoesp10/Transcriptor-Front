# Copia este archivo como .env y ajústalo. .env no se sube al repositorio.

# URL de MeetingTranscriber.Api. Solo la usa el proxy de Vite, nunca el navegador.
# En desarrollo el backend escucha en https://localhost:52610 y en http://localhost:52611.
# El proxy acepta el certificado de desarrollo de ASP.NET.
VITE_BACKEND_URL=https://localhost:52610

# Clave de la API (cabecera X-Api-Key). Va SIN el prefijo VITE_ a propósito: la añade el proxy en el servidor de
# desarrollo y nunca se incluye en el JavaScript que recibe el navegador.
# Este valor es la clave pública de DESARROLLO del backend. En cualquier otro entorno usa tu propia clave.
BACKEND_API_KEY=meeting-transcriber-local-development-key

# Opcional: tamaño máximo por archivo en la interfaz, en MB (igual que el límite del backend, 2 GB por defecto).
# VITE_MAX_FILE_MB=2000
