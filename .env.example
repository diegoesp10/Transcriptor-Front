# URL del backend .NET (solo la usa el proxy de Vite). Perfil del launchSettings.json de MeetingTranscriber.Api:
#   https -> https://localhost:52610 (el que abre Visual Studio; el proxy acepta su certificado de desarrollo)
#   http  -> http://localhost:52611
VITE_BACKEND_URL=https://localhost:52610

# Clave de la API (cabecera X-Api-Key). SIN prefijo VITE_ a propósito: la inyecta el proxy de Vite en el servidor
# de desarrollo y nunca se incluye en el JavaScript que recibe el navegador.
# Esta es la clave pública SOLO de desarrollo de appsettings.Development.json.
BACKEND_API_KEY=meeting-transcriber-local-development-key

# Límite por archivo en el frontal (MB). Igual que Transcription:MaxUploadBytes del backend (2 GB por defecto).
# VITE_MAX_FILE_MB=2000
