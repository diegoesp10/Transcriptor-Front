# Entorno de PRODUCCIÓN: variables del servidor (server/index.mjs). Las lee al arrancar, no al compilar, así que la
# misma compilación (o la misma imagen Docker) sirve para cualquier entorno.
#
# En la plataforma donde publiques (Docker, Azure App Service, un servicio de Windows, Kubernetes…) defínelas como
# variables de entorno o secretos. Para probar en tu equipo: copia este archivo como .env.production (no se sube al
# repositorio) y ejecuta «pnpm build && pnpm start». Las variables reales del sistema tienen prioridad sobre el archivo.

# ── Obligatorias ─────────────────────────────────────────────────────────────

# URL del backend MeetingTranscriber.Api, tal como la ve este servidor (red interna si es posible).
# Puede llevar ruta base: https://api.interna.example.com/transcriber
BACKEND_URL=https://api.interna.example.com

# Clave del backend (cabecera X-Api-Key). Es un SECRETO: en la plataforma, guárdala como secreto, no en el código.
# Tiene que coincidir con Security:ApiKey del backend de producción. La clave de desarrollo no se acepta aquí.
BACKEND_API_KEY=

# ── Opcionales ───────────────────────────────────────────────────────────────

# Nombre del entorno. Cualquier valor distinto de "production" muestra una marca en la barra lateral
# (por ejemplo: staging, test).
APP_ENV=production

# Dónde escucha este servidor.
PORT=8080
HOST=0.0.0.0

# Protege toda la web con usuario y contraseña (recomendado si no hay otro inicio de sesión delante): con una sola
# clave compartida, cualquiera que llegue a la web podría usar la API. Las dos van juntas.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# Solo si el backend está en la red interna con un certificado propio. Nunca contra un servidor público.
# BACKEND_ALLOW_SELF_SIGNED=false

# Activa HSTS cuando la web se sirve SIEMPRE por HTTPS (segundos; 31536000 = un año). 0 = desactivado.
# HSTS_MAX_AGE=0

# Tamaño máximo de subida en MB (el backend tiene su propio límite, 2000 por defecto).
# MAX_UPLOAD_MB=2000

# Cabecera con la IP real del visitante que pone el proxy de delante (IIS) y que el backend usa para sus límites por IP.
# Solo se acepta si la petición llega desde la red privada (IIS → Docker); si no, se usa la IP de la conexión.
# Tiene que coincidir con ReverseProxy:ForwardedForHeaderName del backend.
# CLIENT_IP_HEADER=X-Murmur-Client-IP

# Una línea por petición (método, ruta, estado y tiempo; nunca la query, que lleva nombres de archivo).
# LOG_REQUESTS=true
