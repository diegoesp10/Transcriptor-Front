# Entorno de DESARROLLO (pnpm dev). Este archivo se sube al repositorio: no pongas secretos aquí.
# Para cambiar algo solo en tu equipo, crea .env.development.local (no se sube y tiene prioridad sobre este).

# Backend MeetingTranscriber.Api en tu equipo. Solo lo usa el proxy de Vite, nunca el navegador.
#   https://localhost:52610  perfil https (el proxy acepta el certificado de desarrollo de ASP.NET)
#   http://localhost:52611   perfil http
BACKEND_URL=https://localhost:52610

# Clave pública de DESARROLLO del backend (appsettings.Development.json). La añade el proxy en cada petición.
# El backend de producción la rechaza: allí se usa la clave real, solo como variable de entorno del servidor.
BACKEND_API_KEY=meeting-transcriber-local-development-key

# Opcional: tamaño máximo por archivo en la interfaz, en MB (igual que el backend, 2000 por defecto).
# VITE_MAX_FILE_MB=2000
